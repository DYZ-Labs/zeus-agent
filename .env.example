# Zeus needs an OpenAI API key for the chat loop and the extraction pass.
OPENAI_API_KEY=

# Optional model override. Defaults to gpt-5.6-luna.
# OPENAI_MODEL=gpt-5.6-luna

# Optional web login. Leave the Supabase URL and key blank for loopback-only local
# mode. Once either is set, Zeus fails closed until the URL, key, and site origin are
# complete. Every verified account receives an isolated personal database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Who may create a NEW personal store on this deployment. Comma-separated, and empty
# means nobody: open registration would let any stranger who completes Google login
# allocate a database, a migration run, and a long-lived connection on the host.
# Accounts that already have a store keep working regardless of this list.
# ZEUS_ALLOWED_SIGNUP_EMAILS=you@example.com,teammate@example.com

# Optional migration bridge for a database created before multi-account login. Only
# this email may claim the existing ZEUS_DB while it is unbound; all other accounts use
# UUID-named databases in the sibling accounts/ directory. New installs can leave it blank.
# ZEUS_OWNER_EMAIL=you@example.com

# Where the memory lives. Defaults to ~/.zeus/zeus.db.
# Keep it outside the repo so it can never be committed.
# ZEUS_DB=/Users/you/.zeus/zeus.db
#
# REQUIRED once Supabase login is configured: a hosted deployment must set ZEUS_DB to a
# file on a mounted persistent volume, and Zeus refuses to start otherwise. The default
# lives in the container filesystem, so every deploy would hand each account an empty
# store with nothing logged. The parent directory must already exist — Zeus will not
# create it, because a missing mount point is exactly the failure being caught.
# ZEUS_DB=/data/zeus.db

# Per-account ceilings on model-backed work. Every model call spends one shared OpenAI
# key, so without these a single account — or one client retry loop — can spend without
# limit and take every other account's budget with it. Counters live in each account's
# database, so a restart cannot clear them. Memory browsing, curation, search, and
# export are unaffected by these limits.
# ZEUS_MODEL_CALLS_PER_MINUTE=20
# ZEUS_MODEL_CALLS_PER_DAY=500
# ZEUS_MODEL_TOKENS_PER_DAY=2000000

# How many bounded work runs this process executes at once. A run holds its request for
# up to 900 seconds, so without a cap a few of them starve ordinary chat traffic.
# ZEUS_MAX_CONCURRENT_WORK_RUNS=2

# Ceilings on calls out to connected services. A loop here is traffic against someone
# else's account, under their rate limits, so it is counted durably like model spend.
# ZEUS_CONNECTOR_CALLS_PER_MINUTE=30
# ZEUS_CONNECTOR_CALLS_PER_DAY=1000

# Credentials a manually configured MCP server needs go here, named exactly as you name
# them under Settings -> Connections -> Advanced. Zeus stores only the names and gives
# each connector process only the values you explicitly named. The guided Google Calendar
# preset uses local gcloud Application Default Credentials instead of this file.
# CALENDAR_TOKEN=

# First-party multi-user Google Calendar integration — main Zeus service only. The same
# service key is configured on the separate broker service, but it is never available to
# generic user-configured connectors and is never stored in an account database.
# GOOGLE_CALENDAR_BROKER_URL=https://calendar.zeusagent.dev
# GOOGLE_CALENDAR_BROKER_SERVICE_KEY=

# Google Calendar credential broker service only. Deploy it as a separate Railway
# service with its own persistent volume; do not put Google OAuth credentials or the
# token-encryption key on the main Zeus service.
# GOOGLE_CALENDAR_BROKER_DB=/data/google-calendar-broker.db
# GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=  # base64 encoding of exactly 32 random bytes
# ZEUS_APP_URL=https://www.zeusagent.dev
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://calendar.zeusagent.dev/oauth/google/callback

# How hard SQLite works to survive a host failure. "full" fsyncs each commit and
# survives a power loss; "normal" does not fsync and can lose the most recently
# committed transactions when the host crashes. Measured at 0.06ms/commit for normal
# against 0.14ms for full on this write path, with no difference for rows written inside
# one transaction. Set "normal" only if a slow network volume makes fsync expensive.
# ZEUS_SYNCHRONOUS=full

# How many pre-migration backups to keep per store. Each is a full copy of the database
# on the same volume as the data it protects, so an unbounded series eventually fills the
# disk and blocks the very migration that would fix it. Older copies are pruned when a
# migration runs, so lowering this takes effect at the next schema change. Minimum 1.
# ZEUS_MIGRATION_BACKUP_RETENTION=3

# Scheduled snapshots inside the server process. On by default for a hosted deployment
# (Supabase login configured, NODE_ENV=production), because a mounted volume belongs to
# one service and a separate cron container would not have the store to copy. Off in
# development, where the macOS LaunchAgent below is the explicit path. Set on/off to
# override. Due-ness is read from the newest snapshot on disk, so a redeploy loop cannot
# turn a daily backup into a per-deploy one.
# ZEUS_SNAPSHOT_SCHEDULER=on
# ZEUS_SNAPSHOT_INTERVAL_HOURS=24

# The in-process calendar refresh. On by default everywhere: the standing schedule block
# in chat and the conflict detectors both answer from this cache, so a process that never
# refreshes it is a Zeus that greets every conversation with a stale calendar. A tick with
# no calendar connected costs one local lookup and no network. Set off where the macOS
# ambient LaunchAgent should own refresh alone, or to silence a development server.
# ZEUS_SIGNAL_REFRESH=on
# ZEUS_SIGNAL_REFRESH_MINUTES=15

# Verified online snapshots. By default Zeus uses a snapshots/ directory beside
# ZEUS_DB, keeps the newest 14 snapshots, and schedules the macOS job for 03:00 local.
# Use an absolute directory and reinstall the snapshot LaunchAgent after changes.
# ZEUS_SNAPSHOT_DIR=/Users/you/.zeus/snapshots
# ZEUS_SNAPSHOT_RETENTION=14
# ZEUS_SNAPSHOT_HOUR=3

# Get a copy of each verified snapshot off the volume that holds the original. A hosted
# deployment keeps the store, its pre-migration backups, and its snapshots on one mounted
# volume, so losing that volume loses the backups with the data. Zeus runs this command
# after a snapshot is created and verified, appending the snapshot's absolute path as the
# final argument. No shell: the value is split on whitespace into argv, nothing is
# expanded, and anything needing quoting or two steps belongs in a script you point this
# at. Credentials stay with the tool — restic, rclone, and the cloud CLIs read their own
# secrets from their own environment, and Zeus never stores, logs, or exports them.
# A failed copy is reported on /api/health and never turns a good snapshot into a failure.
# ZEUS_SNAPSHOT_REPLICA_COMMAND=/usr/local/bin/restic backup --tag zeus

# Build-time only, and required on a hosted deployment. onnxruntime-node arrives as a
# plain dependency of @huggingface/transformers and treats every linux/x64 install as a
# CUDA target, fetching ~196MB from api.nuget.org that a CPU-only container never loads.
# The download is neither awaited nor caught, so a nuget outage becomes a failed npm ci
# and a blocked deploy. Set this as a Railway service variable, not just here.
# ONNXRUNTIME_NODE_INSTALL=skip

# Local embedding model. Set ZEUS_EMBEDDINGS=off to run FTS5-only.
# ZEUS_EMBEDDINGS=off

# Where the ~140MB embedding model is cached. Resolved to an absolute path. Point this
# at the mounted volume on a hosted deployment so the model is downloaded once ever
# rather than once per deploy.
# ZEUS_MODEL_CACHE=/data/models

# Load the model at startup instead of inside a user's first search. On by default for a
# hosted deployment; off in development so `npm run dev` does not pull 140MB unasked.
# ZEUS_WARM_EMBEDDINGS=on

# Set during a build that must not reach the network. `npm run build` otherwise caches
# the embedding model so the running server never downloads it.
# ZEUS_SKIP_MODEL_PREFETCH=1
