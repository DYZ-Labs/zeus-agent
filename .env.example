# Zeus needs an OpenAI API key for the chat loop and the extraction pass.
OPENAI_API_KEY=

# Optional model override. Defaults to gpt-5.5.
# OPENAI_MODEL=gpt-5.5

# Optional web login. Leave the URL, key, and owner email blank for the existing
# loopback-only local mode. Once any of those is set, Zeus fails closed until the
# group is complete.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server-only bootstrap gate. The first verified Supabase session must use this email;
# Zeus then binds the local store to that account's immutable Supabase UUID.
ZEUS_OWNER_EMAIL=

# Where the memory lives. Defaults to ~/.zeus/zeus.db.
# Keep it outside the repo so it can never be committed.
# ZEUS_DB=/Users/you/.zeus/zeus.db

# Local embedding model. Set ZEUS_EMBEDDINGS=off to run FTS5-only.
# ZEUS_EMBEDDINGS=off
